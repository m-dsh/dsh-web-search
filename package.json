{
  "name": "dsh-web-search",
  "version": "0.4.0",
  "type": "module",
  "description": "DSH 网页搜索插件：支持 Tavily / Serper 双渠道，Key/无 Key 模式，自定义 API 地址，一键切回官方 DeepSeek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-dsh/dsh-web-search.git"
  },
  "bugs": {
    "url": "https://github.com/m-dsh/dsh-web-search/issues"
  },
  "homepage": "https://github.com/m-dsh/dsh-web-search#readme",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "tavily",
    "serper"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.6.0"
  }
}